# dev uses SQLite automatically (no DB vars needed)
# Uncomment below for prod-like runs

# DJANGO_ENV=prod
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=api.papsasinc.com,papsasinc.com,www.papsasinc.com,88.222.213.225
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.papsasinc.com,https://papsasinc.com,https://www.papsasinc.com

# TIME_ZONE=Asia/Manila
# USE_TZ=True

# POSTGRES_DB=papsas_db
# POSTGRES_USER=papsas_user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# EMAIL_HOST_USER=noreply.papsasinc@gmail.com
# EMAIL_HOST_PASSWORD=

# Reverse proxy / cookies in prod
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Static/media (prod override paths if desired)
# STATIC_ROOT=/var/www/papsas/staticfiles
# MEDIA_ROOT=/srv/papsas/app/media
