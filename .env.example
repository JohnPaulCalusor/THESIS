DJANGO_ENV=development
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB
DJANGO_SECRET_KEY=replace-me

DEBUG=False
ALLOWED_HOSTS=api.papsasinc.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://api.papsasinc.com

# Postgres (used by settings via POSTGRES_* envs)
POSTGRES_DB=papsas
POSTGRES_USER=papsas
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# (Optional) If you ever switch to a single DATABASE_URL, uncomment:
# DATABASE_URL=postgresql://papsas:replace-me@127.0.0.1:5432/papsas

# Email (if you use SMTP)
EMAIL_HOST=smtp.yourhost.tld
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@papsasinc.com
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=True
